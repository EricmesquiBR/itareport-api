FROM node:24-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /app

# Install dependencies
FROM base AS deps
COPY apps/api/package.json ./apps/api/
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --filter @itareport/api

# Build
FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY apps/api/ ./apps/api/
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
RUN pnpm --filter @itareport/api build

# Production
FROM node:24-alpine AS production
WORKDIR /app
COPY --from=build /app/apps/api/dist ./dist
COPY --from=deps /app/apps/api/node_modules ./node_modules
COPY --from=deps /app/node_modules ./root_modules
COPY apps/api/drizzle ./drizzle
COPY apps/api/drizzle.config.ts ./drizzle.config.ts
COPY apps/api/package.json ./
COPY apps/api/.env ./.env
ENV NODE_ENV=production
EXPOSE 3000
CMD ["node", "dist/server.mjs"]
